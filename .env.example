# Ключ авторизации GigaChat API (Base64)
GIGACHAT_CREDENTIALS=your_gigachat_credentials_here

# Адрес OpenAI-совместимого API Ollama (для локального запуска — 127.0.0.1, для Docker — host.docker.internal)
OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5:3b

# URI сервера MLflow (по умолчанию локальная SQLite-база)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
